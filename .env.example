# Copy to .env (git-ignored) and replace every value. Never commit .env.

# --- Anthropic API (only needed when ARL_LLM_BACKEND=anthropic) -----------------
# Create a key at https://console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# scripted = free and deterministic; anthropic = real Claude (costs money)
ARL_LLM_BACKEND=scripted
# Used only when ARL_LLM_BACKEND=anthropic
ARL_MODEL=claude-opus-5-5

# --- Per-run safety envelope (defaults shown; see src/arl/config.py) -------------
ARL_MAX_LLM_CALLS=6
ARL_MAX_OUTPUT_TOKENS_PER_CALL=8000
ARL_MAX_INPUT_TOKENS_PER_RUN=60000
ARL_MAX_OUTPUT_TOKENS_PER_RUN=24000
ARL_MAX_COST_USD_PER_RUN=0.75
ARL_MAX_GRAPH_STEPS=25
ARL_MAX_TOOL_CALLS=10

# --- Local sandbox database passwords (any random strings) -----------------------
OPS_DB_ADMIN_PASSWORD=change-me-ops-admin
ARL_AGENT_DB_PASSWORD=change-me-agent
APP_DB_ADMIN_PASSWORD=change-me-app-admin
ORDERS_APP_PASSWORD=change-me-orders

# The agent's connection to its own database (matches ARL_AGENT_DB_PASSWORD above)
OPS_DATABASE_URL=postgresql://arl_agent:change-me-agent@localhost:5433/arl_ops
